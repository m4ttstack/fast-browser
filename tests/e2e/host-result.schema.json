{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "ok",
    "orderId"
  ],
  "properties": {
    "host": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "ok": {
      "const": true
    },
    "orderId": {
      "type": "string",
      "minLength": 1
    }
  }
}
